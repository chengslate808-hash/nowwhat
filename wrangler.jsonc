// Cloudflare config.
// - Static files in ./public are served directly (free, unlimited).
// - Pages (/, /zh/, /es/, /hi/, /ar/, /day/...) are server-rendered by worker.js + site.js for search and AI crawlers.
// - /api/live serves the 30-second live data from one Durable Object.
{
  "name": "nowwhat",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/day", "/day/*", "/feed.xml", "/sitemap.xml", "/zh", "/zh/*", "/es", "/es/*", "/hi", "/hi/*", "/ar", "/ar/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "Live" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "nowwhat.today", "custom_domain": true },
    { "pattern": "www.nowwhat.today", "custom_domain": true }
  ]
}
