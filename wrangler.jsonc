// Cloudflare config.
// - Static files in ./public are served directly (free, unlimited).
// - Only /api/* runs worker.js, which serves the 30-second live data from one Durable Object.
{
  "name": "nowwhat",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "Live" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "nowwhat.today", "custom_domain": true },
    { "pattern": "www.nowwhat.today", "custom_domain": true }
  ]
}
